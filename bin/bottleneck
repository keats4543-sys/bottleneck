#!/usr/bin/env python3
"""bottleneck - one tmux view over every local Claude Code head.

This is a shim. The program is the package next to it; see bottleneck/cli.py
for the commands and bottleneck/__init__.py for how the parts fit together.
"""
import os
import sys

# Installed as a symlink in ~/.local/bin, so resolve to the real checkout
# before looking for the package.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from bottleneck.cli import run          # noqa: E402

if __name__ == "__main__":
    sys.exit(run())
